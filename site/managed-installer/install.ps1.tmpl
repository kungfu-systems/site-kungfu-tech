# Generated by site-kungfu-tech from one exact signed Alpha.3 publication.
# Catalog: @@CATALOG_ROOT@@
[CmdletBinding()]
param(
  [ValidateSet('alpha')][string]$Channel = '@@CHANNEL@@',
  [string]$Version,
  [string]$InstallDir = (Join-Path $env:LOCALAPPDATA 'Kungfu\product'),
  [string]$CacheDir = (Join-Path $env:LOCALAPPDATA 'Kungfu\cache\installers'),
  [string]$BinDir = (Join-Path $env:LOCALAPPDATA 'Kungfu\bin'),
  [switch]$Rollback,
  [switch]$DryRun,
  [switch]$NoPath,
  [switch]$Yes,
  [switch]$CI
)
$ErrorActionPreference = 'Stop'
$ExactVersion = '@@VERSION@@'
$SourceCommit = '@@SOURCE_COMMIT@@'
$CatalogRoot = '@@CATALOG_ROOT@@'
$ChannelRoot = '@@CHANNEL_ROOT@@'
$ChannelUrl = "https://kungfu.tech/channels/alpha/$ChannelRoot/index.json"
$ChannelSha256 = '@@CHANNEL_DIGEST@@'
$TrustedKey = '@@TRUSTED_KEY@@'
$ReleasePassportRoot = '@@RELEASE_PASSPORT_ROOT@@'
$RequestedVersion = $Version

function Write-Phase([string]$Name, [string]$Message) {
  Write-Host "kungfu-install: phase[$Name]: $Message"
}
function Fail([string]$Category, [string]$Message) {
  throw "error[$Category]: $Message"
}
function Read-Pointer([string]$Pointer) {
  if (-not (Test-Path -LiteralPath $Pointer -PathType Leaf)) { return $null }
  return (Get-Content -LiteralPath $Pointer -TotalCount 1).Trim()
}
function Test-OwnedVersion([string]$Target) {
  if (-not $Target) { return $false }
  $Versions = [IO.Path]::GetFullPath((Join-Path $InstallDir 'versions'))
  $Full = [IO.Path]::GetFullPath($Target)
  return $Full.StartsWith($Versions + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)
}
function Set-AtomicText([string]$Destination, [string]$Text) {
  $Temporary = "$Destination.$PID.$([Guid]::NewGuid().ToString('N')).tmp"
  [IO.File]::WriteAllText($Temporary, $Text, (New-Object Text.UTF8Encoding($false)))
  Move-Item -Force -LiteralPath $Temporary -Destination $Destination
}
function New-LauncherBytes([string]$Target) {
  $Text = "@rem kungfu-site-managed/v1`r`n@setlocal`r`n@set `"KUNGFU_INSTALL_SOURCE=site-managed-archive`"`r`n@set `"KUNGFU_DIR=$Target\runtime`"`r`n@call `"$Target\kungfu.cmd`" %*`r`n"
  return [Text.Encoding]::ASCII.GetBytes($Text)
}
function Set-AtomicLauncher([string]$Destination, [string]$Target) {
  $Temporary = "$Destination.$PID.tmp"
  [IO.File]::WriteAllBytes($Temporary, (New-LauncherBytes $Target))
  Move-Item -Force -LiteralPath $Temporary -Destination $Destination
}
function Test-LegacyProductLauncher([string]$Launcher) {
  # The product bootstrap predates the Site-managed marker. Require its full,
  # product-specific command shape before replacing it during migration.
  $Expected = @(
    '@echo off',
    'set "KUNGFU_PRODUCT_MANIFEST=%~dp0product.json"',
    'set "KUNGFU_UPGRADE_MANIFEST=%~dp0upgrade\kungfu-release-manifest.json"',
    'set "KF_BUNDLED_EXTENSION_ROOT=%~dp0extensions"',
    'set "KUNGFU_AGENT_SESSION_EXECUTABLE=%~dp0runtime\kungfu.exe"',
    'set "KUNGFU_CONTROLLER_ENTRYPOINT=%~dp0runtime\kungfu.exe"',
    'set "PYTHONUTF8=1"',
    'set "PYTHONIOENCODING=utf-8"',
    '"%~dp0runtime\kungfu.exe" %*'
  )
  $Actual = @(Get-Content -LiteralPath $Launcher)
  if ($Actual.Count -ne $Expected.Count) { return $false }
  for ($Index = 0; $Index -lt $Expected.Count; $Index += 1) {
    if ($Actual[$Index] -cne $Expected[$Index]) { return $false }
  }
  return $true
}
function Test-OwnedLauncher([string]$Launcher) {
  if (-not (Test-Path -LiteralPath $Launcher)) { return $true }
  if (-not (Test-Path -LiteralPath $Launcher -PathType Leaf)) { return $false }
  if ((Get-Content -LiteralPath $Launcher -TotalCount 1) -in @(
    '@rem kungfu-site-managed/v1',
    '@rem kungfu-archive-bootstrap/v1'
  )) { return $true }
  return Test-LegacyProductLauncher $Launcher
}

if ($Channel -ne '@@CHANNEL@@') { Fail 'channel-unavailable' 'this installer is pinned to alpha' }
if ($RequestedVersion -and $RequestedVersion -ne $ExactVersion) {
  Fail 'version-unavailable' "this installer selects exactly $ExactVersion"
}
if (-not [Environment]::Is64BitOperatingSystem) { Fail 'unsupported-platform' '64-bit Windows is required' }
if ([Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString() -ne 'x64') {
  Fail 'unsupported-architecture' 'Alpha.3 supports Windows x64 only'
}

$Architecture = 'x64'
$Platform = 'win32'
$ManifestRoot = '@@WIN32_X64_MANIFEST_ROOT@@'
$ArtifactRoot = '@@WIN32_X64_ARTIFACT_ROOT@@'
$ReleaseCutRoot = '@@WIN32_X64_RELEASE_CUT_ROOT@@'
$PlatformSliceRoot = '@@WIN32_X64_PLATFORM_SLICE_ROOT@@'
$ArtifactUrl = '@@WIN32_X64_ARTIFACT_URL@@'
$ArtifactSize = [int64]@@WIN32_X64_ARTIFACT_SIZE@@
$ArtifactDigest = '@@WIN32_X64_ARTIFACT_DIGEST@@'
$ArchiveName = '@@WIN32_X64_ARCHIVE_NAME@@'
$ArchiveBase = '@@WIN32_X64_ARCHIVE_BASE@@'
$ArchiveEntries = @@WIN32_X64_ARCHIVE_ENTRIES@@
$ArchiveLinks = @@WIN32_X64_ARCHIVE_LINKS@@
$VersionKey = $ManifestRoot.Substring(7, 16)
$VersionRoot = Join-Path $InstallDir "versions\$ExactVersion-$VersionKey"
$CurrentPointer = Join-Path $InstallDir 'current.path'
$PreviousPointer = Join-Path $InstallDir 'previous.path'
$Launcher = Join-Path $BinDir 'kungfu.cmd'
$ReceiptLine = "catalog=$CatalogRoot version=$ExactVersion source=$SourceCommit manifest=$ManifestRoot artifact=$ArtifactRoot passport=$ReleasePassportRoot"
Write-Phase 'plan' "$Channel $ExactVersion $Platform/$Architecture -> $VersionRoot"
if ($Rollback) { Write-Phase 'plan' "rollback current=$CurrentPointer previous=$PreviousPointer" }
if ($DryRun) { exit 0 }

if (-not (Test-OwnedLauncher $Launcher)) {
  Fail 'ownership-conflict' "$Launcher is not owned by the Kungfu managed installer"
}
$Existing = Get-Command kungfu -ErrorAction SilentlyContinue
if ($Existing -and [IO.Path]::GetFullPath($Existing.Source) -ne [IO.Path]::GetFullPath($Launcher)) {
  Fail 'ownership-conflict' "existing Kungfu is owned outside ${Launcher}: $($Existing.Source)"
}

if ($Rollback) {
  $CurrentTarget = Read-Pointer $CurrentPointer
  $PreviousTarget = Read-Pointer $PreviousPointer
  if (-not (Test-OwnedVersion $CurrentTarget)) { Fail 'rollback-ownership' 'current does not name a managed version' }
  if (-not (Test-OwnedVersion $PreviousTarget)) { Fail 'rollback-unavailable' 'no verified previous version exists' }
  $PreviousReceipt = Join-Path $PreviousTarget 'install\site-managed-receipt'
  $PreviousBootstrapReceipt = Join-Path $PreviousTarget 'install\bootstrap-receipt.json'
  if (
    -not (Test-Path -LiteralPath $PreviousReceipt -PathType Leaf) -or
    (Get-Content -LiteralPath $PreviousReceipt -Raw).TrimEnd() -notmatch '^catalog=sha256:[a-f0-9]{64} version=[^ ]+ source=[a-f0-9]{40} manifest=sha256:[a-f0-9]{64} artifact=sha256:[a-f0-9]{64} passport=sha256:[a-f0-9]{64}$'
  ) { Fail 'rollback-verification' 'previous managed receipt is missing or invalid' }
  try { $PreviousBootstrap = Get-Content -LiteralPath $PreviousBootstrapReceipt -Raw | ConvertFrom-Json }
  catch { Fail 'rollback-verification' 'previous product bootstrap receipt is unreadable' }
  if ($PreviousBootstrap.state -ne 'verified') { Fail 'rollback-verification' 'previous product bootstrap receipt is not verified' }
  $PreviousCommand = Join-Path $PreviousTarget 'kungfu.cmd'
  if (-not (Test-Path -LiteralPath $PreviousCommand -PathType Leaf)) { Fail 'rollback-verification' 'previous Kungfu command is missing' }
  $PreviousVersion = (& $PreviousCommand --version 2>$null | Select-Object -First 1)
  if (-not $PreviousVersion) { Fail 'rollback-verification' 'previous Kungfu did not report a version' }
  New-Item -ItemType Directory -Force -Path $InstallDir, $BinDir | Out-Null
  $OldLauncher = if (Test-Path -LiteralPath $Launcher) { [IO.File]::ReadAllBytes($Launcher) } else { $null }
  try {
    Set-AtomicLauncher $Launcher $PreviousTarget
    Set-AtomicText $CurrentPointer "$PreviousTarget`n"
    $Observed = (& $Launcher --version 2>$null | Select-Object -First 1)
    if ($Observed -ne $PreviousVersion) { Fail 'rollback-verification' "launcher did not report $PreviousVersion" }
    Set-AtomicText $PreviousPointer "$CurrentTarget`n"
  }
  catch {
    Set-AtomicText $CurrentPointer "$CurrentTarget`n"
    if ($OldLauncher) { [IO.File]::WriteAllBytes($Launcher, $OldLauncher) }
    Fail 'rollback-failed' $_.Exception.Message
  }
  Write-Phase 'rollback' "$Launcher -> $PreviousTarget ($PreviousVersion)"
  exit 0
}

$ManagedReceipt = Join-Path $VersionRoot 'install\site-managed-receipt'
if (
  (Test-Path -LiteralPath $ManagedReceipt -PathType Leaf) -and
  ((Get-Content -LiteralPath $ManagedReceipt -Raw).TrimEnd() -eq $ReceiptLine) -and
  ((Read-Pointer $CurrentPointer) -eq $VersionRoot) -and
  (Test-OwnedLauncher $Launcher)
) {
  $InstalledVersion = (& (Join-Path $VersionRoot 'kungfu.cmd') --version 2>$null | Select-Object -First 1)
  if ($InstalledVersion -eq $ExactVersion) {
    Write-Phase 'idempotent' "verified $ExactVersion is already active"
    exit 0
  }
}

function Invoke-ResumableDownload([string]$Uri, [string]$Destination, [int64]$ExpectedSize, [string]$Label) {
  Add-Type -AssemblyName System.Net.Http
  for ($Attempt = 1; $Attempt -le 5; $Attempt += 1) {
    $Offset = if (Test-Path -LiteralPath $Destination) { (Get-Item -LiteralPath $Destination).Length } else { [int64]0 }
    Write-Phase 'download' "$Label attempt $Attempt/5, resume-byte $Offset"
    $Client = New-Object Net.Http.HttpClient
    $Request = New-Object Net.Http.HttpRequestMessage([Net.Http.HttpMethod]::Get, $Uri)
    if ($Offset -gt 0) { $Request.Headers.Range = New-Object Net.Http.Headers.RangeHeaderValue($Offset, $null) }
    try {
      $Response = $Client.SendAsync($Request, [Net.Http.HttpCompletionOption]::ResponseHeadersRead).GetAwaiter().GetResult()
      $Status = [int]$Response.StatusCode
      if ($Offset -gt 0 -and $Status -eq 206) { $Mode = [IO.FileMode]::Append }
      elseif ($Status -eq 200) { $Mode = [IO.FileMode]::Create; $Offset = 0 }
      else { throw "HTTP $Status did not honor a safe complete or Range response" }
      $InputStream = $Response.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
      $OutputStream = New-Object IO.FileStream($Destination, $Mode, [IO.FileAccess]::Write, [IO.FileShare]::Read)
      try {
        $Buffer = New-Object byte[] (1024 * 1024)
        $Transferred = $Offset
        $LastReport = [DateTime]::UtcNow
        while (($Read = $InputStream.Read($Buffer, 0, $Buffer.Length)) -gt 0) {
          $OutputStream.Write($Buffer, 0, $Read)
          $Transferred += $Read
          if (-not $CI -and ([DateTime]::UtcNow - $LastReport).TotalSeconds -ge 1) {
            $Percent = if ($ExpectedSize -gt 0) { [Math]::Min(100, [Math]::Floor(100 * $Transferred / $ExpectedSize)) } else { 0 }
            Write-Progress -Activity "Downloading $Label" -Status "$Transferred / $ExpectedSize bytes" -PercentComplete $Percent
            $LastReport = [DateTime]::UtcNow
          }
        }
      }
      finally {
        if ($OutputStream) { $OutputStream.Dispose() }
        if ($InputStream) { $InputStream.Dispose() }
        if (-not $CI) { Write-Progress -Activity "Downloading $Label" -Completed }
      }
      return
    }
    catch {
      if ($Attempt -ge 5) { Fail 'download-failed' "$Label failed after 5 attempts; partial retained at ${Destination}: $($_.Exception.Message)" }
      $Delay = @(1, 2, 4, 8)[$Attempt - 1]
      Write-Phase 'retry' "$Label failed; retrying in ${Delay}s"
      Start-Sleep -Seconds $Delay
    }
    finally {
      if ($Request) { $Request.Dispose() }
      if ($Response) { $Response.Dispose() }
      if ($Client) { $Client.Dispose() }
    }
  }
}

New-Item -ItemType Directory -Force -Path (Join-Path $InstallDir 'versions'), $BinDir | Out-Null
$Lock = Join-Path $InstallDir '.managed-install.lock'
try { New-Item -ItemType Directory -Path $Lock -ErrorAction Stop | Out-Null }
catch { Fail 'concurrent-install' "another Kungfu installer owns $Lock" }
$Stage = Join-Path $InstallDir ".managed-stage.$([Guid]::NewGuid().ToString('N'))"
try {
  New-Item -ItemType Directory -Path $Stage | Out-Null
  $DownloadRoot = Join-Path $Stage 'download'
  $ExtractRoot = Join-Path $Stage 'extract'
  New-Item -ItemType Directory -Path $DownloadRoot, $ExtractRoot | Out-Null
  $ChannelFile = Join-Path $DownloadRoot 'channel.json'
  Invoke-ResumableDownload $ChannelUrl $ChannelFile 0 'signed channel'
  if ((Get-FileHash -Algorithm SHA256 -LiteralPath $ChannelFile).Hash.ToLowerInvariant() -ne $ChannelSha256) {
    Fail 'channel-byte-mismatch' 'channel bytes differ from the reviewed signed channel'
  }

  $CacheRoot = Join-Path $CacheDir "sha256\$ArtifactDigest"
  $CacheFile = Join-Path $CacheRoot $ArchiveName
  $PartialFile = "$CacheFile.part"
  New-Item -ItemType Directory -Force -Path $CacheRoot | Out-Null
  $CacheValid = $false
  if (Test-Path -LiteralPath $CacheFile -PathType Leaf) {
    $Cached = Get-Item -LiteralPath $CacheFile
    $CachedDigest = (Get-FileHash -Algorithm SHA256 -LiteralPath $CacheFile).Hash.ToLowerInvariant()
    if ($Cached.Length -eq $ArtifactSize -and $CachedDigest -eq $ArtifactDigest) {
      $CacheValid = $true
      Write-Phase 'cache' "verified archive reused from $CacheFile"
    }
    else {
      Move-Item -LiteralPath $CacheFile -Destination "$CacheFile.rejected.$PID"
      Write-Phase 'cache' 'rejected unverified cache entry'
    }
  }
  if (-not $CacheValid) {
    Invoke-ResumableDownload $ArtifactUrl $PartialFile $ArtifactSize 'CLI archive'
    $Partial = Get-Item -LiteralPath $PartialFile
    if ($Partial.Length -ne $ArtifactSize) { Fail 'artifact-size-mismatch' "expected $ArtifactSize bytes, received $($Partial.Length); partial retained at $PartialFile" }
    $ObservedDigest = (Get-FileHash -Algorithm SHA256 -LiteralPath $PartialFile).Hash.ToLowerInvariant()
    if ($ObservedDigest -ne $ArtifactDigest) { Fail 'artifact-digest-mismatch' "archive digest differs; partial retained at $PartialFile" }
    Move-Item -LiteralPath $PartialFile -Destination $CacheFile
    Write-Phase 'cache' "stored verified archive at $CacheFile"
  }

  Write-Phase 'extract' 'validating exact archive closure'
  Add-Type -AssemblyName System.IO.Compression.FileSystem
  $Archive = [IO.Compression.ZipFile]::OpenRead($CacheFile)
  try {
    if ($Archive.Entries.Count -ne $ArchiveEntries) { Fail 'archive-closure-mismatch' "expected $ArchiveEntries entries, observed $($Archive.Entries.Count)" }
    $RootPrefix = "$ArchiveBase/"
    $ExtractFull = [IO.Path]::GetFullPath($ExtractRoot) + [IO.Path]::DirectorySeparatorChar
    $ObservedLinks = 0
    foreach ($Entry in $Archive.Entries) {
      $Name = $Entry.FullName.Replace('\', '/')
      if (
        -not $Name.StartsWith($RootPrefix, [StringComparison]::Ordinal) -or
        $Name.StartsWith('/') -or
        $Name.Split('/') -contains '..' -or
        $Name -match '^[A-Za-z]:'
      ) { Fail 'archive-unsafe' "unsafe archive path: $Name" }
      $Destination = [IO.Path]::GetFullPath((Join-Path $ExtractRoot $Name))
      if (-not $Destination.StartsWith($ExtractFull, [StringComparison]::OrdinalIgnoreCase)) { Fail 'archive-unsafe' "archive path escapes extraction root: $Name" }
      $UnixType = (($Entry.ExternalAttributes -shr 16) -band 0xF000)
      if ($UnixType -eq 0xA000) { $ObservedLinks += 1 }
      elseif ($UnixType -notin @(0, 0x4000, 0x8000)) { Fail 'archive-unsafe' "unsupported archive entry type: $Name" }
    }
    if ($ObservedLinks -ne $ArchiveLinks) { Fail 'archive-closure-mismatch' "expected $ArchiveLinks reviewed links, observed $ObservedLinks" }
  }
  finally { $Archive.Dispose() }
  [IO.Compression.ZipFile]::ExtractToDirectory($CacheFile, $ExtractRoot)
  $Candidate = Join-Path $ExtractRoot $ArchiveBase
  $ProductManifest = Join-Path $Candidate 'product.json'
  $Runtime = Join-Path $Candidate 'runtime\kungfu.exe'
  $CandidateCommand = Join-Path $Candidate 'kungfu.cmd'
  if (-not (Test-Path -LiteralPath $ProductManifest -PathType Leaf)) { Fail 'product-manifest-missing' 'product.json is missing' }
  if (-not (Test-Path -LiteralPath $Runtime -PathType Leaf)) { Fail 'runtime-missing' 'runtime\kungfu.exe is missing' }
  if (-not (Test-Path -LiteralPath $CandidateCommand -PathType Leaf)) { Fail 'runtime-missing' 'kungfu.cmd is missing' }

  Write-Phase 'verify' 'running the Alpha.3 product bootstrap verifier'
  $InstallMetadata = Join-Path $Candidate 'install'
  New-Item -ItemType Directory -Force -Path $InstallMetadata | Out-Null
  $AdapterFile = Join-Path $InstallMetadata 'alpha3-bootstrap-adapter.py'
  $AdapterSource = @'
@@ALPHA3_ADAPTER@@
'@
  [IO.File]::WriteAllText($AdapterFile, "$AdapterSource`n", (New-Object Text.UTF8Encoding($false)))
  if ((Get-FileHash -Algorithm SHA256 -LiteralPath $AdapterFile).Hash.ToLowerInvariant() -ne '@@ALPHA3_ADAPTER_DIGEST@@') {
    Fail 'product-verification-failed' 'embedded Alpha.3 compatibility adapter digest differs from the catalog'
  }
  $CandidatePython = Join-Path $Candidate 'runtime\python\python.exe'
  if (-not (Test-Path -LiteralPath $CandidatePython -PathType Leaf)) { Fail 'product-verification-failed' 'candidate embedded Python is unavailable' }
  $AdapterReceipt = Join-Path $InstallMetadata 'alpha3-bootstrap-adapter-receipt.json'
  $ReceiptJson = & $CandidatePython $AdapterFile $ChannelFile $CacheFile $Candidate `
    --channel $Channel --platform $Platform --architecture $Architecture --version $ExactVersion `
    --manifest-root $ManifestRoot --artifact-root $ArtifactRoot --platform-trust signed-channel-digest `
    --trusted-key $TrustedKey --adapter-receipt $AdapterReceipt
  if ($LASTEXITCODE -ne 0) { Fail 'product-verification-failed' 'staged Kungfu rejected the signed release identity' }
  [IO.File]::WriteAllText((Join-Path $InstallMetadata 'bootstrap-receipt.json'), (($ReceiptJson -join [Environment]::NewLine) + [Environment]::NewLine), (New-Object Text.UTF8Encoding($false)))
  $CandidateVersion = (& $CandidateCommand --version 2>$null | Select-Object -First 1)
  if ($CandidateVersion -ne $ExactVersion) { Fail 'product-version-mismatch' "staged Kungfu reported '$CandidateVersion'" }
  [IO.File]::WriteAllText((Join-Path $InstallMetadata 'site-managed-receipt'), "$ReceiptLine`n", (New-Object Text.UTF8Encoding($false)))

  if (Test-Path -LiteralPath $VersionRoot) {
    $ExistingReceipt = Join-Path $VersionRoot 'install\site-managed-receipt'
    if (-not (Test-Path -LiteralPath $ExistingReceipt -PathType Leaf) -or (Get-Content -LiteralPath $ExistingReceipt -Raw).TrimEnd() -ne $ReceiptLine) {
      Fail 'installed-content-conflict' "$VersionRoot exists without the exact managed receipt"
    }
    Remove-Item -Recurse -Force -LiteralPath $Candidate
    Write-Phase 'publish' 'verified installed content reused'
  }
  else {
    Move-Item -LiteralPath $Candidate -Destination $VersionRoot
    Write-Phase 'publish' "installed complete archive closure at $VersionRoot"
  }

  $OldCurrent = Read-Pointer $CurrentPointer
  if ($OldCurrent -and -not (Test-OwnedVersion $OldCurrent)) { Fail 'activation-ownership' 'current points outside the managed versions directory' }
  $OldPrevious = Read-Pointer $PreviousPointer
  if ($OldPrevious -and -not (Test-OwnedVersion $OldPrevious)) { Fail 'activation-ownership' 'previous points outside the managed versions directory' }
  $OldLauncher = if (Test-Path -LiteralPath $Launcher) { [IO.File]::ReadAllBytes($Launcher) } else { $null }
  try {
    Set-AtomicLauncher $Launcher $VersionRoot
    Set-AtomicText $CurrentPointer "$VersionRoot`n"
    $Observed = (& $Launcher --version 2>$null | Select-Object -First 1)
    if ($Observed -ne $ExactVersion) { Fail 'activation-verification-failed' "activated launcher did not report $ExactVersion" }
    if ($OldCurrent -and $OldCurrent -ne $VersionRoot) { Set-AtomicText $PreviousPointer "$OldCurrent`n" }
  }
  catch {
    if ($OldCurrent) { Set-AtomicText $CurrentPointer "$OldCurrent`n" } else { Remove-Item -Force -ErrorAction SilentlyContinue -LiteralPath $CurrentPointer }
    if ($OldLauncher) { [IO.File]::WriteAllBytes($Launcher, $OldLauncher) } else { Remove-Item -Force -ErrorAction SilentlyContinue -LiteralPath $Launcher }
    Fail 'activation-failed' "$($_.Exception.Message); prior current was restored"
  }
  Write-Phase 'installed' "$Launcher -> $VersionRoot"
  Write-Host "kungfu-install: PATH, profiles, registry, services, and scheduled tasks were not modified"
  Write-Host "kungfu-install: cache=$CacheFile current=$CurrentPointer previous=$PreviousPointer"
}
finally {
  Remove-Item -Recurse -Force -ErrorAction SilentlyContinue -LiteralPath $Stage
  Remove-Item -Force -ErrorAction SilentlyContinue -LiteralPath $Lock
}
